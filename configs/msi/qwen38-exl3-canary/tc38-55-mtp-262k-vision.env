# ThinkingCap-Qwen3.8-27B EXL3 5.5bpw (own conversion, 2026-09-24) on the same
# engine/kit/flags as 55-mtp-262k-vision. PROMOTED to production 2026-09-24
# (../serve-qwen38-exl3.sh). MODEL_DIR is absolute: the checkpoint lives on the
# ext4 home volume, not under the kit's models/ (see ../thinkingcap38-exl3/).
# Rebuild: thinkingcap38-exl3/convert-run.sh (recipe = TelperionAI 5.5bpw minus
# the AWQ pre-pass: bits 5.5, head 6, mtp 4, vision bf16, mul1, cal 250x2048).
EXL3_REPO=git+https://github.com/MiaAI-Lab/exllamav3@63b32f001d7b2cfed3b3e3aaf25f534ba53cc7ed
MODEL_DIR=/home/<user>/models/bottlecapai/ThinkingCap-Qwen3.8-27B-EXL3-5.5bpw
HF_TARGET_REPO=bottlecapai/ThinkingCap-Qwen3.8-27B
SERVED_MODEL_NAME=thinkingcap-qwen3.8-27b-exl3-5.5bpw
DRAFT=mtp
PORT=8102
HOST=0.0.0.0
CONTEXT_SIZE=262144
CACHE_QUANT=nvfp4
GPU_MEM_GB=29
CPU_CACHE_GB=0
MAX_JOBS=4
VENV_DIR=/home/<user>/qwen38-exl3-venv
VISION=1
