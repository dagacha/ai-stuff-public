+def _fetch_image_url(url):
+    """GET a public http(s) image URL with redirects re-validated and the
+    body read in chunks up to _IMAGE_MAX_BYTES."""
+    import http.client, urllib.parse
+    for _ in range(_IMAGE_MAX_REDIRECTS + 1):
+        u = urllib.parse.urlsplit(url)
+        if u.scheme not in ("http", "https") or not u.hostname:
+            raise ValueError(f"unsupported image URL {url!r}")
+        if u.username or u.password:
+            raise ValueError("credentials in image URLs are not accepted")
+        conn = _pinned_connection(u.scheme, u.hostname, u.port, _IMAGE_FETCH_TIMEOUT)
+        try:
+            path = u.path or "/"
+            if u.query:
+                path += "?" + u.query
+            conn.request("GET", path, headers = {"User-Agent": "serve_openai-vision/1",
+                                                 "Accept": "image/*"})
+            resp = conn.getresponse()
+            if resp.status in (301, 302, 303, 307, 308):
+                loc = resp.getheader("Location")
+                if not loc:
+                    raise ValueError(f"redirect without Location from {url!r}")
+                url = urllib.parse.urljoin(url, loc)
+                continue
+            if resp.status != 200:
+                raise ValueError(f"image URL returned HTTP {resp.status}")
+            clen = resp.getheader("Content-Length")
+            if clen and clen.isdigit() and int(clen) > _IMAGE_MAX_BYTES:
+                raise ValueError(f"image exceeds {_IMAGE_MAX_BYTES >> 20} MiB")
+            chunks, total = [], 0
+            while True:
+                chunk = resp.read(1 << 16)
+                if not chunk:
+                    break
+                total += len(chunk)
+                if total > _IMAGE_MAX_BYTES:
+                    raise ValueError(f"image exceeds {_IMAGE_MAX_BYTES >> 20} MiB")
+                chunks.append(chunk)
+            return b"".join(chunks)
+        finally:
+            conn.close()
+    raise ValueError("too many redirects fetching image URL")
+
