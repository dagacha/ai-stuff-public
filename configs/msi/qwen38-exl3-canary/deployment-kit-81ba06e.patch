+def _public_address(host):
+    """Resolve host, refuse anything that is not a public unicast address
+    (checked on every resolved address, so a name that maps to a private IP
+    alongside a public one is rejected too) and return the validated
+    (family, sockaddr) to connect to. The caller must connect to exactly
+    that address: resolving again at connect time would let a rebinding
+    DNS name pass validation publicly and then connect privately."""
+    import ipaddress, socket
+    try:
+        infos = socket.getaddrinfo(host, None, proto = socket.IPPROTO_TCP)
+    except socket.gaierror as e:
+        raise ValueError(f"cannot resolve image host {host!r}: {e}")
+    if not infos:
+        raise ValueError(f"cannot resolve image host {host!r}")
+    for info in infos:
+        ip = ipaddress.ip_address(info[4][0])
+        if getattr(ip, "ipv4_mapped", None) is not None:
+            ip = ip.ipv4_mapped
+        if not ip.is_global or ip.is_multicast:
+            raise ValueError(f"image host {host!r} resolves to a non-public "
+                             f"address ({ip}); refused")
+    family, _, _, _, sockaddr = infos[0]
+    return family, sockaddr
+
+
+def _pinned_connection(scheme, hostname, port, timeout):
+    """HTTP(S) connection whose TCP socket goes to the address validated by
+    _public_address, while Host header and TLS SNI/verification still use
+    the original hostname."""
+    import http.client, socket, ssl
+    port = port or (443 if scheme == "https" else 80)
+    family, sockaddr = _public_address(hostname)
+    sock = socket.socket(family, socket.SOCK_STREAM)
+    sock.settimeout(timeout)
+    try:
+        sock.connect((sockaddr[0], port) + tuple(sockaddr[2:]))
+    except BaseException:
+        sock.close()
+        raise
+    if scheme == "https":
+        sock = ssl.create_default_context().wrap_socket(sock, server_hostname = hostname)
+        conn = http.client.HTTPSConnection(hostname, port, timeout = timeout)
+    else:
+        conn = http.client.HTTPConnection(hostname, port, timeout = timeout)
+    conn.sock = sock        # pre-connected: http.client skips its own connect()
+    return conn
+
