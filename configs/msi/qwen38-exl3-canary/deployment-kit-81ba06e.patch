+def _load_image(url):
+    import base64, io
+    from PIL import Image
+    if url.startswith("data:"):
+        header, _, payload = url.partition(",")
+        if ";base64" not in header:
+            raise ValueError("only base64 data: URIs are supported")
+        if len(payload) * 3 // 4 > _IMAGE_MAX_BYTES:
+            raise ValueError(f"image exceeds {_IMAGE_MAX_BYTES >> 20} MiB")
+        raw = base64.b64decode(payload)
+    elif url.startswith(("http://", "https://")):
+        if not _ALLOW_IMAGE_URLS:
+            raise ValueError("remote image URLs are disabled on this server; "
+                             "send a base64 data: URI (or start with --allow_image_urls)")
+        raw = _fetch_image_url(url)
+    else:
+        raise ValueError("image_url must be a base64 data: URI or an http(s) URL")
+    img = Image.open(io.BytesIO(raw))
+    if img.width * img.height > _IMAGE_MAX_PIXELS:
+        raise ValueError(f"image is {img.width}x{img.height}; limit is "
+                         f"{_IMAGE_MAX_PIXELS / 1e6:g} MP")
+    return img.convert("RGB")
+
