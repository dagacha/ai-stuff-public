+def _image_embedding(vision_model, tokenizer, url):
+    import hashlib
+    key = hashlib.blake2b(url.encode("utf-8"), digest_size = 16).digest()
+    with _image_cache_lock:
+        hit = _image_cache.get(key)
+        if hit is not None and hit[0] == url:
+            _image_cache[key] = _image_cache.pop(key)
+            return hit[1]
+    mme = vision_model.get_image_embeddings(tokenizer = tokenizer,
+                                            image = _load_image(url))
+    with _image_cache_lock:
+        if len(_image_cache) >= _IMAGE_CACHE_CAP:
+            _image_cache.pop(next(iter(_image_cache)))
+        _image_cache[key] = (url, mme)
+    return mme
+
