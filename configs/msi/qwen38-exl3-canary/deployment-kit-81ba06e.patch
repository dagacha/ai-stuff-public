+# Remote image_url fetching is off by default: a server-side fetch of a
+# client-supplied URL is an SSRF vector (loopback, Tailscale, LAN, cloud
+# metadata) and an unbounded download. `--allow_image_urls` enables it with
+# destination filtering and size caps; data: URIs are always accepted.
+_ALLOW_IMAGE_URLS = False
+_IMAGE_MAX_BYTES = 32 * 1024 * 1024
+_IMAGE_MAX_PIXELS = 64_000_000     # 28 MP test images pass; bombs do not
+_IMAGE_FETCH_TIMEOUT = 30
+_IMAGE_MAX_REDIRECTS = 3
+
