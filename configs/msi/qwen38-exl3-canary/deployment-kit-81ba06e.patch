+def attach_images(messages, vision_model, tokenizer):
+    """OpenAI content-part lists -> plain template text.
+
+    Text parts are kept; image parts become the embedding's text alias (the
+    engine expands it to <vision_start> + image tokens + <vision_end>, so it
+    is placed directly in the text rather than through the template's
+    image placeholder, which this engine build does not expose).
+    Returns (messages, embeddings)."""
+    out, embeddings = [], []
+    for m in messages:
+        content = m.get("content")
+        if not isinstance(content, list):
+            out.append(m)
+            continue
+        pieces = []
+        for part in content:
+            ptype = part.get("type") if isinstance(part, dict) else None
+            if ptype == "text":
+                pieces.append(part.get("text") or "")
+            elif ptype == "image_url":
+                url = part.get("image_url")
+                if isinstance(url, dict):
+                    url = url.get("url")
+                if not url:
+                    raise ValueError("image_url part without a url")
+                if vision_model is None:
+                    raise ValueError("image input requires a server started with --vision")
+                mme = _image_embedding(vision_model, tokenizer, url)
+                embeddings.append(mme)
+                pieces.append(mme.text_alias)
+            else:
+                raise ValueError(f"unsupported content part type: {ptype!r}")
+        m = dict(m)
+        m["content"] = "\n".join(pieces)
+        out.append(m)
+    return out, embeddings
